{
  "manifest_version": 3,
  "name": "QuotaHush",
  "version": "0.1.4",
  "description": "Shows Claude Code, Codex, DeepSeek, and Z.AI usage through the QuotaHush local server.",
  "homepage_url": "https://wenress.github.io/QuotaHush/",
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuotaHush"
  },
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
