# Copy this file to .var.env and add only the credentials for the providers
# you want to enable. Never commit the populated .var.env file.

# Installed Companions check official stable GitHub releases automatically.
# Set to 0 to disable automatic updates.
QUOTAHUSH_AUTO_UPDATE=1

# Official DeepSeek API key, used to retrieve the account balance.
DEEPSEEK_API_KEY=

# Optional DeepSeek platform session token, used for dashboard usage history.
# Treat this value like a password.
DEEPSEEK_PLATFORM_TOKEN=

# Z.AI API key, used to retrieve Usage Bundle information.
ZAI_API_KEY=
